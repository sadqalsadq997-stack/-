# ══════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env (للتشغيل المحلي) — وفي Vercel أضف نفس القيم
# في Settings → Environment Variables. لا ترفع .env على GitHub أبداً.
# ══════════════════════════════════════════════════════

# Supabase — تُقرأ في السيرفر فقط (وكيل /api/db) ولا تظهر في المتصفح
# لاحظ: بدون بادئة VITE_ — هذا مقصود
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Moyasar — المفتاح "العام" فقط (pk_...). مسموح للمتصفح لأنه يرسل البطاقة مباشرة لميسر
# المفتاح السري (sk_...) مكانه Supabase Edge Functions Secrets فقط
VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# ⚠️ لا تضف هنا أي مفتاح سري. هذه القيم مكانها Supabase → Edge Functions → Secrets:
#   GEMINI_API_KEY, MOYASAR_SECRET_KEY, MOYASAR_WEBHOOK_SECRET, BILLING_CRON_SECRET,
#   OWNER_PIN_HASH, NAMECHEAP_API_KEY ...
