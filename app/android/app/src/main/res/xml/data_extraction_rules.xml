<?xml version="1.0" encoding="utf-8"?>
<!-- بيانات المنشأة (الجلسة والفواتير المحفوظة) ما تنسخ للسحابة ولا تنتقل لجهاز ثاني -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
